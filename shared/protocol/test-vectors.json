{
  "about": "Protocol v1 conformance vectors. Each platform's test suite feeds `frame` (the JSON body) or `lengthPrefix` to its receiver and asserts `expect`. See docs/protocol.md section 3.",
  "defaults": {
    "negotiatedVersion": 1,
    "capabilities": ["device", "calls.state", "calls.control", "calls.log", "sms.read", "sms.send", "notifications.read", "notifications.act", "photos.read", "drop", "clipboard"]
  },
  "expectValues": {
    "accept": "passed validation, handed to the feature handler",
    "close": "protocol error, connection closed, nothing sent",
    "error:<CODE>": "ERROR with this code sent, replyTo = frame id, connection stays open"
  },
  "vectors": [
    { "name": "ping accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"a1\",\"type\":\"PING\",\"ts\":1790000000000,\"payload\":{}}",
      "expect": "accept" },
    { "name": "unknown envelope field ignored", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"a2\",\"type\":\"PING\",\"ts\":1,\"payload\":{},\"future\":true}",
      "expect": "accept" },
    { "name": "unknown payload field ignored", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"a3\",\"type\":\"BATTERY_CHANGED\",\"ts\":1,\"payload\":{\"level\":57,\"charging\":false,\"temp\":31}}",
      "expect": "accept" },
    { "name": "call answer accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"a4\",\"type\":\"CALL_ANSWER\",\"ts\":1,\"payload\":{\"callId\":\"c-9\"}}",
      "expect": "accept" },

    { "name": "zero length frame", "receiver": "phone", "lengthPrefix": 0, "expect": "close" },
    { "name": "frame over 1 MiB", "receiver": "phone", "lengthPrefix": 1048577, "expect": "close" },
    { "name": "not json", "receiver": "phone", "frame": "hello", "expect": "close" },
    { "name": "json array not object", "receiver": "phone", "frame": "[1,2]", "expect": "close" },
    { "name": "missing id", "receiver": "phone",
      "frame": "{\"v\":1,\"type\":\"PING\",\"ts\":1,\"payload\":{}}", "expect": "close" },
    { "name": "id with illegal chars", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"a b\",\"type\":\"PING\",\"ts\":1,\"payload\":{}}", "expect": "close" },
    { "name": "payload missing", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"b1\",\"type\":\"PING\",\"ts\":1}", "expect": "close" },
    { "name": "ts is a string", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"b2\",\"type\":\"PING\",\"ts\":\"now\",\"payload\":{}}", "expect": "close" },
    { "name": "wrong protocol version", "receiver": "phone",
      "frame": "{\"v\":2,\"id\":\"b3\",\"type\":\"PING\",\"ts\":1,\"payload\":{}}", "expect": "close" },

    { "name": "unknown type", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"c1\",\"type\":\"TELEPORT\",\"ts\":1,\"payload\":{}}", "expect": "error:UNSUPPORTED_TYPE" },
    { "name": "type in wrong direction", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"c2\",\"type\":\"CALL_STATE\",\"ts\":1,\"payload\":{\"callId\":\"c-1\",\"state\":\"RINGING\",\"direction\":\"IN\",\"since\":1}}",
      "expect": "error:UNSUPPORTED_TYPE" },
    { "name": "call answer without callId", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"c3\",\"type\":\"CALL_ANSWER\",\"ts\":1,\"payload\":{}}", "expect": "error:INVALID_PAYLOAD" },
    { "name": "battery level out of range", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"c4\",\"type\":\"BATTERY_CHANGED\",\"ts\":1,\"payload\":{\"level\":140,\"charging\":true}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "call state bad enum", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"c5\",\"type\":\"CALL_STATE\",\"ts\":1,\"payload\":{\"callId\":\"c-1\",\"state\":\"HOLD\",\"direction\":\"IN\",\"since\":1}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "thread page too large", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"c6\",\"type\":\"SMS_THREADS_GET\",\"ts\":1,\"payload\":{\"limit\":101}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "hello with keepAlive accepted", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"d1\",\"type\":\"HELLO\",\"ts\":1,\"payload\":{\"protocol\":{\"min\":1,\"max\":1},\"app\":\"0.5.0\",\"deviceId\":\"7fcde326d3a90dead570ea1892db1173\",\"name\":\"narzo 50\",\"platform\":\"android\",\"capabilities\":[\"device\"],\"keepAlive\":3}}",
      "expect": "accept" },
    { "name": "hello keepAlive out of range", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"d2\",\"type\":\"HELLO\",\"ts\":1,\"payload\":{\"protocol\":{\"min\":1,\"max\":1},\"app\":\"0.5.0\",\"deviceId\":\"7fcde326d3a90dead570ea1892db1173\",\"name\":\"narzo 50\",\"platform\":\"android\",\"capabilities\":[\"device\"],\"keepAlive\":0}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "hello from a linux pc accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"d3\",\"type\":\"HELLO\",\"ts\":1,\"payload\":{\"protocol\":{\"min\":1,\"max\":1},\"app\":\"0.15.0\",\"deviceId\":\"0a1b2c3d4e5f60718293a4b5c6d7e8f9\",\"name\":\"ubuntu-desktop\",\"platform\":\"linux\",\"capabilities\":[\"notifications.read\"]}}",
      "expect": "accept" },
    { "name": "hello from an unknown platform", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"d4\",\"type\":\"HELLO\",\"ts\":1,\"payload\":{\"protocol\":{\"min\":1,\"max\":1},\"app\":\"0.15.0\",\"deviceId\":\"0a1b2c3d4e5f60718293a4b5c6d7e8f9\",\"name\":\"toaster\",\"platform\":\"tizen\",\"capabilities\":[]}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "call log get accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"e1\",\"type\":\"CALL_LOG_GET\",\"ts\":1,\"payload\":{\"limit\":50,\"before\":1790000000000}}",
      "expect": "accept" },
    { "name": "call log get limit too large", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"e2\",\"type\":\"CALL_LOG_GET\",\"ts\":1,\"payload\":{\"limit\":500}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "call log accepted by pc", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"e3\",\"type\":\"CALL_LOG\",\"ts\":1,\"payload\":{\"calls\":[{\"id\":\"812\",\"number\":\"+639171234567\",\"name\":\"Mika\",\"type\":\"MISSED\",\"date\":1790000000000,\"duration\":0},{\"id\":\"811\",\"type\":\"IN\",\"date\":1789990000000,\"duration\":74}]}}",
      "expect": "accept" },
    { "name": "call log entry with unknown type", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"e4\",\"type\":\"CALL_LOG\",\"ts\":1,\"payload\":{\"calls\":[{\"id\":\"812\",\"type\":\"HOLD\",\"date\":1,\"duration\":0}]}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "call log without capability", "receiver": "pc",
      "capabilities": ["device", "calls.state"],
      "frame": "{\"v\":1,\"id\":\"e5\",\"type\":\"CALL_LOG\",\"ts\":1,\"payload\":{\"calls\":[]}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "notification posted accepted by pc", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"f1\",\"type\":\"NOTIFICATION_POSTED\",\"ts\":1,\"payload\":{\"key\":\"0|com.whatsapp|1|null|10123\",\"package\":\"com.whatsapp\",\"appName\":\"WhatsApp\",\"title\":\"Mika\",\"text\":\"See you at 7\",\"postedAt\":1790000000000,\"clearable\":true,\"actions\":[{\"index\":0,\"title\":\"Reply\",\"reply\":true},{\"index\":1,\"title\":\"Mark as read\",\"reply\":false}]}}",
      "expect": "accept" },
    { "name": "notification with too many actions", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"f2\",\"type\":\"NOTIFICATION_POSTED\",\"ts\":1,\"payload\":{\"key\":\"k\",\"package\":\"p\",\"appName\":\"A\",\"postedAt\":1,\"clearable\":true,\"actions\":[{\"index\":0,\"title\":\"a\",\"reply\":false},{\"index\":1,\"title\":\"b\",\"reply\":false},{\"index\":2,\"title\":\"c\",\"reply\":false},{\"index\":3,\"title\":\"d\",\"reply\":false},{\"index\":4,\"title\":\"e\",\"reply\":false},{\"index\":5,\"title\":\"f\",\"reply\":false}]}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "notification reply accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"f3\",\"type\":\"NOTIFICATION_ACTION\",\"ts\":1,\"payload\":{\"key\":\"0|com.whatsapp|1|null|10123\",\"index\":0,\"replyText\":\"On my way\"}}",
      "expect": "accept" },
    { "name": "notification dismiss without capability", "receiver": "phone",
      "capabilities": ["device", "notifications.read"],
      "frame": "{\"v\":1,\"id\":\"f4\",\"type\":\"NOTIFICATION_DISMISS\",\"ts\":1,\"payload\":{\"key\":\"k\"}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "transfer pull accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"g1\",\"type\":\"TRANSFER_PULL\",\"ts\":1,\"payload\":{\"kind\":\"photo\",\"id\":\"812\"}}",
      "expect": "accept" },
    { "name": "transfer pull of an unknown kind", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"g2\",\"type\":\"TRANSFER_PULL\",\"ts\":1,\"payload\":{\"kind\":\"file\",\"id\":\"/sdcard/secret.txt\"}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "file push accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"h1\",\"type\":\"TRANSFER_PUSH\",\"ts\":1,\"payload\":{\"kind\":\"file\",\"name\":\"Report.pdf\",\"size\":204800,\"mime\":\"application/pdf\"}}",
      "expect": "accept" },
    { "name": "drop offer accepted by pc", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"h2\",\"type\":\"DROP_OFFER\",\"ts\":1,\"payload\":{\"dropId\":\"a1b2c3d4e5f60718\",\"files\":[{\"index\":0,\"name\":\"VID_1.mp4\",\"size\":5000000,\"mime\":\"video/mp4\"}]}}",
      "expect": "accept" },
    { "name": "drop offer with too many files", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"h3\",\"type\":\"DROP_OFFER\",\"ts\":1,\"payload\":{\"dropId\":\"a1\",\"files\":[{\"index\":60,\"name\":\"x\",\"size\":1,\"mime\":\"a/b\"}]}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "clipboard accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"i1\",\"type\":\"CLIPBOARD_SET\",\"ts\":1,\"payload\":{\"text\":\"Room 4B, 3rd floor\"}}",
      "expect": "accept" },
    { "name": "clipboard accepted by pc", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"i2\",\"type\":\"CLIPBOARD_SET\",\"ts\":1,\"payload\":{\"text\":\"https://example.com/a\"}}",
      "expect": "accept" },
    { "name": "device status accepted by pc", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"j1\",\"type\":\"DEVICE_STATUS\",\"ts\":1,\"payload\":{\"wifi\":true,\"wifiSignal\":3,\"bluetooth\":false,\"storageFree\":1000}}",
      "expect": "accept" },
    { "name": "wifi signal out of range", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"j2\",\"type\":\"DEVICE_STATUS\",\"ts\":1,\"payload\":{\"wifi\":true,\"wifiSignal\":5,\"storageFree\":1}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "ring accepted by phone", "receiver": "phone", "capabilities": ["device", "ring"],
      "frame": "{\"v\":1,\"id\":\"j3\",\"type\":\"RING\",\"ts\":1,\"payload\":{\"on\":true}}",
      "expect": "accept" },
    { "name": "media control accepted by phone", "receiver": "phone", "capabilities": ["device", "media"],
      "frame": "{\"v\":1,\"id\":\"j4\",\"type\":\"MEDIA_CONTROL\",\"ts\":1,\"payload\":{\"action\":\"next\"}}",
      "expect": "accept" },
    { "name": "unknown media action", "receiver": "phone", "capabilities": ["device", "media"],
      "frame": "{\"v\":1,\"id\":\"j5\",\"type\":\"MEDIA_CONTROL\",\"ts\":1,\"payload\":{\"action\":\"shuffle\"}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "media control without capability", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"j6\",\"type\":\"MEDIA_CONTROL\",\"ts\":1,\"payload\":{\"action\":\"play\"}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "contacts page request accepted by phone", "receiver": "phone", "capabilities": ["device", "contacts.read"],
      "frame": "{\"v\":1,\"id\":\"k1\",\"type\":\"CONTACTS_GET\",\"ts\":1,\"payload\":{\"limit\":500,\"offset\":500}}",
      "expect": "accept" },
    { "name": "contacts page accepted by pc", "receiver": "pc", "capabilities": ["device", "contacts.read"],
      "frame": "{\"v\":1,\"id\":\"k2\",\"type\":\"CONTACTS\",\"ts\":1,\"payload\":{\"more\":false,\"contacts\":[{\"id\":\"7\",\"name\":\"Ana\",\"numbers\":[{\"number\":\"+15550100\",\"type\":\"mobile\",\"label\":\"Mobile\"}],\"emails\":[\"ana@example.com\"]}]}}",
      "expect": "accept" },
    { "name": "contact number with unknown type", "receiver": "phone", "capabilities": ["device", "contacts.write"],
      "frame": "{\"v\":1,\"id\":\"k3\",\"type\":\"CONTACT_SAVE\",\"ts\":1,\"payload\":{\"name\":\"Ana\",\"numbers\":[{\"number\":\"1\",\"type\":\"pager\"}],\"emails\":[]}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "contact delete without write capability", "receiver": "phone", "capabilities": ["device", "contacts.read"],
      "frame": "{\"v\":1,\"id\":\"k4\",\"type\":\"CONTACT_DELETE\",\"ts\":1,\"payload\":{\"id\":\"7\"}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "call log search accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"k5\",\"type\":\"CALL_LOG_GET\",\"ts\":1,\"payload\":{\"limit\":50,\"query\":\"ana\"}}",
      "expect": "accept" },
    { "name": "sms send without capability", "receiver": "phone",
      "capabilities": ["device", "sms.read"],
      "frame": "{\"v\":1,\"id\":\"c7\",\"type\":\"SMS_SEND\",\"ts\":1,\"payload\":{\"address\":\"+15550100\",\"body\":\"hi\"}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "group mms send accepted by phone", "receiver": "phone", "capabilities": ["device", "sms.send"],
      "frame": "{\"v\":1,\"id\":\"m1\",\"type\":\"MMS_SEND\",\"ts\":1,\"payload\":{\"addresses\":[\"+15550100\",\"+15550101\"],\"body\":\"hi all\"}}",
      "expect": "accept" },
    { "name": "group mms send with no addresses", "receiver": "phone", "capabilities": ["device", "sms.send"],
      "frame": "{\"v\":1,\"id\":\"m2\",\"type\":\"MMS_SEND\",\"ts\":1,\"payload\":{\"addresses\":[],\"body\":\"hi\"}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "mms message with a picture accepted by pc", "receiver": "pc", "capabilities": ["device", "sms.read"],
      "frame": "{\"v\":1,\"id\":\"m3\",\"type\":\"SMS_MESSAGES\",\"ts\":1,\"payload\":{\"messages\":[{\"messageId\":\"mms-4\",\"address\":\"+15550100\",\"body\":\"\",\"date\":1,\"outgoing\":false,\"read\":true,\"parts\":[{\"id\":\"9\",\"mime\":\"image/jpeg\",\"name\":\"IMG_1.jpg\"}]}]}}",
      "expect": "accept" },
    { "name": "mms part without mime", "receiver": "pc", "capabilities": ["device", "sms.read"],
      "frame": "{\"v\":1,\"id\":\"m4\",\"type\":\"SMS_RECEIVED\",\"ts\":1,\"payload\":{\"threadId\":\"1\",\"messageId\":\"mms-4\",\"address\":\"+15550100\",\"body\":\"\",\"date\":1,\"parts\":[{\"id\":\"9\"}]}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "mms attachment pull accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"m5\",\"type\":\"TRANSFER_PULL\",\"ts\":1,\"payload\":{\"kind\":\"mms\",\"id\":\"9\"}}",
      "expect": "accept" },
    { "name": "contact photo without picture accepted by pc", "receiver": "pc", "capabilities": ["device", "contacts.read"],
      "frame": "{\"v\":1,\"id\":\"m6\",\"type\":\"CONTACT_PHOTO\",\"ts\":1,\"payload\":{\"id\":\"7\"}}",
      "expect": "accept" },
    { "name": "pc notification accepted by phone", "receiver": "phone", "capabilities": ["device", "pc.notifications"],
      "frame": "{\"v\":1,\"id\":\"n1\",\"type\":\"PC_NOTIFICATION\",\"ts\":1,\"payload\":{\"id\":\"42\",\"app\":\"Outlook\",\"title\":\"Ana\",\"text\":\"Lunch?\"}}",
      "expect": "accept" },
    { "name": "pc notification when the phone can't show them", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"n2\",\"type\":\"PC_NOTIFICATION_REMOVED\",\"ts\":1,\"payload\":{\"id\":\"42\"}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "albums accepted by pc", "receiver": "pc", "capabilities": ["device", "photos.read"],
      "frame": "{\"v\":1,\"id\":\"q1\",\"type\":\"ALBUMS\",\"ts\":1,\"payload\":{\"albums\":[{\"id\":\"-1739773001\",\"name\":\"Camera\",\"count\":1234}]}}",
      "expect": "accept" },
    { "name": "folder push accepted by phone", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"q2\",\"type\":\"TRANSFER_PUSH\",\"ts\":1,\"payload\":{\"kind\":\"file\",\"name\":\"a.jpg\",\"size\":3,\"mime\":\"image/jpeg\",\"folder\":\"Trip/Day 1\"}}",
      "expect": "accept" },
    { "name": "drop offer with unknown purpose", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"q3\",\"type\":\"DROP_OFFER\",\"ts\":1,\"payload\":{\"dropId\":\"d1\",\"files\":[],\"purpose\":\"print\"}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "device status with mobile signal accepted by pc", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"r1\",\"type\":\"DEVICE_STATUS\",\"ts\":1,\"payload\":{\"wifi\":true,\"wifiSignal\":3,\"storageFree\":1000,\"cellSignal\":4,\"cellNetwork\":\"LTE\",\"carrier\":\"Smart\"}}",
      "expect": "accept" },
    { "name": "mobile signal out of range", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"r2\",\"type\":\"DEVICE_STATUS\",\"ts\":1,\"payload\":{\"wifi\":true,\"storageFree\":1000,\"cellSignal\":5}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "camera request without a camera", "receiver": "phone",
      "frame": "{\"v\":1,\"id\":\"q4\",\"type\":\"CAMERA_REQUEST\",\"ts\":1,\"payload\":{}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "pc remote state accepted by phone", "receiver": "phone", "capabilities": ["device", "remote"],
      "frame": "{\"v\":1,\"id\":\"s1\",\"type\":\"PC_REMOTE\",\"ts\":1,\"payload\":{\"input\":true,\"media\":true,\"commands\":[{\"id\":\"c1\",\"name\":\"Shut down\"}],\"title\":\"Song\",\"playing\":true,\"volume\":40,\"muted\":false}}",
      "expect": "accept" },
    { "name": "pointer move accepted by pc", "receiver": "pc", "capabilities": ["device", "remote"],
      "frame": "{\"v\":1,\"id\":\"s2\",\"type\":\"REMOTE_POINTER\",\"ts\":1,\"payload\":{\"dx\":-12,\"dy\":7}}",
      "expect": "accept" },
    { "name": "pointer move too far", "receiver": "pc", "capabilities": ["device", "remote"],
      "frame": "{\"v\":1,\"id\":\"s3\",\"type\":\"REMOTE_POINTER\",\"ts\":1,\"payload\":{\"dx\":9000,\"dy\":0}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "remote key not on the list", "receiver": "pc", "capabilities": ["device", "remote"],
      "frame": "{\"v\":1,\"id\":\"s4\",\"type\":\"REMOTE_KEY\",\"ts\":1,\"payload\":{\"key\":\"win\"}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "pc lock from an old phone without remote", "receiver": "pc",
      "frame": "{\"v\":1,\"id\":\"s5\",\"type\":\"PC_LOCK\",\"ts\":1,\"payload\":{}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "screen request accepted by phone", "receiver": "phone", "capabilities": ["device", "screen"],
      "frame": "{\"v\":1,\"id\":\"t1\",\"type\":\"SCREEN_REQUEST\",\"ts\":1,\"payload\":{}}",
      "expect": "accept" },
    { "name": "screen touch accepted while control is on", "receiver": "phone", "capabilities": ["device", "screen", "screen.control"],
      "frame": "{\"v\":1,\"id\":\"t2\",\"type\":\"SCREEN_TOUCH\",\"ts\":1,\"payload\":{\"x1\":5000,\"y1\":2500,\"x2\":5000,\"y2\":7500,\"ms\":300}}",
      "expect": "accept" },
    { "name": "screen touch while control is off", "receiver": "phone", "capabilities": ["device", "screen"],
      "frame": "{\"v\":1,\"id\":\"t3\",\"type\":\"SCREEN_TOUCH\",\"ts\":1,\"payload\":{\"x1\":1,\"y1\":1,\"x2\":1,\"y2\":1,\"ms\":50}}",
      "expect": "error:NOT_CAPABLE" },
    { "name": "screen touch off the screen", "receiver": "phone", "capabilities": ["device", "screen", "screen.control"],
      "frame": "{\"v\":1,\"id\":\"t4\",\"type\":\"SCREEN_TOUCH\",\"ts\":1,\"payload\":{\"x1\":10001,\"y1\":1,\"x2\":1,\"y2\":1,\"ms\":50}}",
      "expect": "error:INVALID_PAYLOAD" },
    { "name": "screen state accepted by pc", "receiver": "pc", "capabilities": ["device", "screen"],
      "frame": "{\"v\":1,\"id\":\"t5\",\"type\":\"SCREEN_STATE\",\"ts\":1,\"payload\":{\"state\":\"declined\"}}",
      "expect": "accept" },
    { "name": "phone may not send pc remote state", "receiver": "pc", "capabilities": ["device", "remote"],
      "frame": "{\"v\":1,\"id\":\"s6\",\"type\":\"PC_REMOTE\",\"ts\":1,\"payload\":{\"input\":true,\"media\":true,\"commands\":[]}}",
      "expect": "error:UNSUPPORTED_TYPE" }
  ]
}

<Page
    x:Class="Palwyn.App.PhotosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Palwyn.App">

    <Grid Padding="40,24,40,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Photos" />
                <local:ScrollSafeComboBox
                    x:Name="AlbumBox"
                    MinWidth="180"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Album"
                    DisplayMemberPath="Label"
                    SelectionChanged="AlbumBox_SelectionChanged"
                    Visibility="Collapsed" />
            </StackPanel>
            <TextBlock
                x:Name="SelectionText"
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <Button
                x:Name="SelectAllButton"
                Grid.Column="2"
                Click="SelectAll_Click"
                Content="Select all"
                ToolTipService.ToolTip="Select everything shown (Ctrl+A)" />
            <Button
                x:Name="OpenButton"
                Grid.Column="3"
                Click="Open_Click"
                Content="Open"
                IsEnabled="False"
                ToolTipService.ToolTip="Open full size (Enter or double-click)" />
            <Button
                x:Name="SaveButton"
                Grid.Column="4"
                Click="Save_Click"
                Content="Save to Pictures"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CameraButton"
                Grid.Column="5"
                AutomationProperties.Name="Take a photo with your phone"
                Click="Camera_Click"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Take a photo with your phone"
                Visibility="Collapsed">
                <FontIcon FontSize="16" Glyph="&#xE722;" />
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="6"
                AutomationProperties.Name="Refresh"
                Click="Refresh_Click"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Refresh">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <InfoBar x:Name="Result" Grid.Row="1" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="OpenFolderButton" Click="OpenFolder_Click" Content="Open folder" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid
            x:Name="TransferPanel"
            Grid.Row="2"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="TransferText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <ProgressBar x:Name="TransferBar" Maximum="1" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Click="Cancel_Click"
                Content="Cancel" />
        </Grid>

        <ProgressBar
            x:Name="ListLoading"
            Grid.Row="2"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <GridView
            x:Name="Grid"
            Grid.Row="3"
            Margin="-4,8,-4,0"
            Padding="0,0,0,32"
            ContainerContentChanging="Grid_ContainerContentChanging"
            DoubleTapped="Grid_DoubleTapped"
            KeyDown="Grid_KeyDown"
            SelectionChanged="Grid_SelectionChanged"
            SelectionMode="Extended">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:PhotoRow">
                    <Grid
                        Width="150"
                        Height="150"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        ToolTipService.ToolTip="{x:Bind Label}">
                        <Image
                            AutomationProperties.Name="{x:Bind Label}"
                            Source="{x:Bind Thumb, Mode=OneWay}"
                            Stretch="UniformToFill" />
                        <Border
                            Margin="6"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#99000000"
                            CornerRadius="4"
                            Visibility="{x:Bind IsVideo}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="White"
                                    Glyph="&#xE768;" />
                                <TextBlock
                                    Foreground="White"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Duration}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.Footer>
                <Button
                    x:Name="MoreButton"
                    Margin="4,12"
                    Click="More_Click"
                    Content="Show older photos"
                    Visibility="Collapsed" />
            </GridView.Footer>
        </GridView>

        <local:Skeleton
            x:Name="Placeholder"
            Grid.Row="3"
            Margin="-4,8,-4,0"
            Count="18"
            Tiles="True"
            Visibility="Collapsed" />
        <local:StateView
            x:Name="State"
            Grid.Row="3"
            Visibility="Collapsed" />
    </Grid>
</Page>

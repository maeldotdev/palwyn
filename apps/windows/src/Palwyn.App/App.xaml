<Application
    x:Class="Palwyn.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <BitmapImage x:Key="AppLogo" UriSource="ms-appx:///Assets/Logo.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <BitmapImage x:Key="AppLogo" UriSource="ms-appx:///Assets/Logo-light.png" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  JetBrains Mono (SIL OFL, Assets/Fonts) is the app font; long reading text keeps the system font.  -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono.ttf#JetBrains Mono</FontFamily>
            <FontFamily x:Key="ReadingFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <!--  The built-in text styles hard-code the system font, so each is re-declared on top of the original.  -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
            <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>

            <!--  Brand green as the accent, instead of the Windows accent colour. Dark1 keeps white text readable.  -->
            <Color x:Key="SystemAccentColor">#12A67C</Color>
            <Color x:Key="SystemAccentColorLight1">#1FB88C</Color>
            <Color x:Key="SystemAccentColorLight2">#2ED3A1</Color>
            <Color x:Key="SystemAccentColorLight3">#6FE0BE</Color>
            <Color x:Key="SystemAccentColorDark1">#0B7A5B</Color>
            <Color x:Key="SystemAccentColorDark2">#08654B</Color>
            <Color x:Key="SystemAccentColorDark3">#054634</Color>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>

            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

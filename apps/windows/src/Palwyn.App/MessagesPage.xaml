<Page
    x:Class="Palwyn.App.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Palwyn.App">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Conversations  -->
        <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="24,24,12,12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Messages" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="NewButton"
                        AutomationProperties.Name="New message"
                        Click="New_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="New message">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Refresh"
                        Click="Refresh_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
            <AutoSuggestBox
                x:Name="Search"
                Grid.Row="1"
                Margin="24,0,24,12"
                AutomationProperties.Name="Search messages"
                PlaceholderText="Search messages"
                QueryIcon="Find"
                TextChanged="Search_TextChanged" />
            <ProgressBar
                x:Name="ThreadsLoading"
                Grid.Row="2"
                IsIndeterminate="True"
                Visibility="Collapsed" />
            <ListView
                x:Name="Threads"
                Grid.Row="3"
                Padding="0,0,0,16"
                SelectionChanged="Threads_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ThreadRow">
                        <Grid Padding="0,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="40"
                                Height="40"
                                local:ContactPhotos.Number="{x:Bind Number}"
                                DisplayName="{x:Bind Initials}" />
                            <Grid
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontWeight="{x:Bind TitleWeight}"
                                    MaxLines="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind When}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontFamily="{StaticResource ReadingFontFamily}"
                                    Text="{x:Bind Snippet}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <Button
                        x:Name="MoreThreadsButton"
                        Margin="16,8"
                        Click="MoreThreads_Click"
                        Content="Show older conversations"
                        Visibility="Collapsed" />
                </ListView.Footer>
            </ListView>
            <local:Skeleton
                x:Name="ThreadsPlaceholder"
                Grid.Row="3"
                Padding="24,0"
                Visibility="Collapsed" />
            <local:StateView
                x:Name="ThreadsState"
                Grid.Row="3"
                Padding="24,0"
                Visibility="Collapsed" />
        </Grid>

        <!--  Conversation  -->
        <TextBlock
            x:Name="NoSelection"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="Select a conversation" />

        <Grid
            x:Name="Conversation"
            Grid.Column="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  New message: who to  -->
            <Grid
                x:Name="NewHeader"
                Padding="24,20,24,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="12"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="To" />
                <AutoSuggestBox
                    x:Name="ToBox"
                    Grid.Column="1"
                    MaxWidth="400"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="To"
                    DisplayMemberPath="Display"
                    PlaceholderText="Name or phone number"
                    QuerySubmitted="To_QuerySubmitted"
                    SuggestionChosen="To_SuggestionChosen"
                    TextChanged="To_TextChanged"
                    TextMemberPath="Number" />
            </Grid>
            <Grid
                x:Name="ThreadHeader"
                Padding="24,20,24,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ContactButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Contact options"
                    Click="Contact_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Add to contacts, edit or delete">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                </Button>
                <PersonPicture
                    x:Name="HeaderPicture"
                    Width="36"
                    Height="36" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HeaderTitle"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="HeaderSubtitle"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
            <ProgressBar
                x:Name="MessagesLoading"
                Grid.Row="1"
                IsIndeterminate="True"
                Visibility="Collapsed" />
            <ListView
                x:Name="Bubbles"
                Grid.Row="2"
                Padding="24,8,24,8"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Header>
                    <Button
                        x:Name="MoreMessagesButton"
                        Margin="0,8"
                        HorizontalAlignment="Center"
                        Click="MoreMessages_Click"
                        Content="Show older messages"
                        Visibility="Collapsed" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BubbleRow">
                        <StackPanel
                            Margin="0,4"
                            HorizontalAlignment="{x:Bind Align}"
                            Spacing="2">
                            <TextBlock
                                Margin="12,0,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Sender}"
                                Visibility="{x:Bind HasSender}" />
                            <ItemsControl
                                HorizontalAlignment="{x:Bind Align}"
                                ItemsSource="{x:Bind Attachments}"
                                Visibility="{x:Bind HasAttachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AttachmentRow">
                                        <Button
                                            Margin="0,2"
                                            Padding="0"
                                            HorizontalAlignment="{x:Bind Align}"
                                            AutomationProperties.Name="{x:Bind Label}"
                                            Click="Attachment_Click"
                                            CornerRadius="12"
                                            ToolTipService.ToolTip="Open">
                                            <Grid>
                                                <Image
                                                    MaxWidth="280"
                                                    MaxHeight="280"
                                                    Source="{x:Bind Image, Mode=OneWay}"
                                                    Stretch="Uniform" />
                                                <StackPanel
                                                    Padding="12,8"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Visibility="{x:Bind ShowLabel, Mode=OneWay}">
                                                    <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                                                    <TextBlock Text="{x:Bind Label}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border
                                MaxWidth="460"
                                Padding="12,8"
                                HorizontalAlignment="{x:Bind Align}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="12"
                                Visibility="{x:Bind OutgoingText}">
                                <TextBlock
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    FontFamily="{StaticResource ReadingFontFamily}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Body}"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                MaxWidth="460"
                                Padding="12,8"
                                HorizontalAlignment="{x:Bind Align}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Visibility="{x:Bind IncomingText}">
                                <TextBlock
                                    FontFamily="{StaticResource ReadingFontFamily}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Body}"
                                    TextWrapping="Wrap" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="{x:Bind Align}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Meta}"
                                Visibility="{x:Bind NotFailed}" />
                            <TextBlock
                                HorizontalAlignment="{x:Bind Align}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Meta}"
                                Visibility="{x:Bind Failed}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="MessagesError"
                Grid.Row="2"
                Margin="24,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Grid
                Grid.Row="3"
                Padding="24,12,24,20"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="8"
                RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="Composer"
                    MaxHeight="140"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Text message"
                    MaxLength="5000"
                    PlaceholderText="Text message"
                    PreviewKeyDown="Composer_PreviewKeyDown"
                    TextChanged="Composer_TextChanged"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmojiButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Emoji"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Emoji">
                    <FontIcon FontSize="16" Glyph="&#xE76E;" />
                    <Button.Flyout>
                        <Flyout x:Name="EmojiFlyout" Closed="EmojiFlyout_Closed" Placement="TopEdgeAlignedRight">
                            <GridView
                                x:Name="EmojiGrid"
                                Width="336"
                                MaxHeight="264"
                                AutomationProperties.Name="Emoji"
                                IsItemClickEnabled="True"
                                ItemClick="Emoji_ItemClick"
                                SelectionMode="None">
                                <GridView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                        <Setter Property="Width" Value="40" />
                                        <Setter Property="Height" Value="40" />
                                        <Setter Property="MinWidth" Value="40" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Emoji"
                                            FontSize="20"
                                            Text="{x:Bind}" />
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="SendButton"
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Send"
                    Click="Send_Click"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Send (Enter)">
                    <FontIcon FontSize="16" Glyph="&#xE724;" />
                </Button>
                <TextBlock
                    x:Name="ComposerHint"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="Palwyn.App.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Palwyn.App">

    <Page.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!--  Small uppercase label at the top of a tile.  -->
        <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1040"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch"
            Spacing="12">

            <StackPanel
                x:Name="EmptyState"
                MaxWidth="560"
                HorizontalAlignment="Left"
                Spacing="12">
                <local:PhoneStatusHeader x:Name="EmptyHeader" IsLarge="True" />
                <TextBlock
                    Margin="0,20,0,0"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Your Android phone, right here on this PC"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Phone and PC talk directly over your Wi-Fi, encrypted. No account, no cloud."
                    TextWrapping="Wrap" />
                <StackPanel Margin="0,12,0,12" Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE717;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Calls, texts and notifications" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Answer calls, reply to messages and act on notifications without picking up the phone."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE898;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Photos, files, links and clipboard" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Browse the phone's photos and move files, text and links either way."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE768;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Media, ring and quick actions" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Control what's playing and find your phone from the tray."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Button
                    Click="Add_Click"
                    Content="Add a phone"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <StackPanel
                x:Name="PairedState"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="Problem"
                    MaxWidth="560"
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />

                <!--  The bento: tiles are placed in rows by Arrange(), two columns when wide, one when narrow.  -->
                <Grid
                    x:Name="Bento"
                    ColumnSpacing="12"
                    RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DeviceTile" Style="{StaticResource TileStyle}">
                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:PhoneStatusHeader
                                x:Name="Header"
                                IsLarge="True"
                                ShowBattery="False" />
                            <StackPanel
                                x:Name="BatteryBlock"
                                Grid.Row="2"
                                Spacing="6">
                                <TextBlock Style="{StaticResource TileLabelStyle}" Text="BATTERY" />
                                <TextBlock
                                    x:Name="BatteryBig"
                                    FontSize="44"
                                    FontWeight="SemiBold"
                                    LineHeight="48" />
                                <ProgressBar x:Name="BatteryBar" Maximum="100" />
                                <TextBlock
                                    x:Name="BatteryDetail"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Now playing and quick actions; collapses itself when there's nothing to show.  -->
                    <local:PhoneControls
                        x:Name="Controls"
                        Columns="3"
                        TileButtons="True" />

                    <!--  What is happening with the phone right now.  -->
                    <ItemsRepeater x:Name="Tiles">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="3"
                                MinColumnSpacing="12"
                                MinItemWidth="180"
                                MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:DashTile">
                                <Grid
                                    Padding="16,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                        <TextBlock Style="{StaticResource TileLabelStyle}" Text="{x:Bind LabelCaps}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,0"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="{x:Bind Value}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ProgressBar
                                        Grid.Row="2"
                                        Margin="0,4,0,2"
                                        Maximum="1"
                                        Visibility="{x:Bind HasFill}"
                                        Value="{x:Bind FillValue}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        MaxLines="1"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border
                        x:Name="NotificationsSection"
                        Style="{StaticResource TileStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Style="{StaticResource TileLabelStyle}" Text="NOTIFICATIONS" />
                                <HyperlinkButton
                                    HorizontalAlignment="Right"
                                    Click="AllNotifications_Click"
                                    Content="See all" />
                            </Grid>
                            <StackPanel x:Name="RecentNotifications" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="PhotosSection"
                        Style="{StaticResource TileStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Style="{StaticResource TileLabelStyle}" Text="RECENT PHOTOS" />
                                <HyperlinkButton
                                    HorizontalAlignment="Right"
                                    Click="AllPhotos_Click"
                                    Content="See all" />
                            </Grid>
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel
                                    x:Name="RecentPhotos"
                                    Padding="0,0,0,8"
                                    Orientation="Horizontal"
                                    Spacing="8" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ActivityTile" Style="{StaticResource TileStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource TileLabelStyle}" Text="RECENT ACTIVITY" />
                            <TextBlock
                                x:Name="NoActivity"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Nothing yet. Calls, texts, files and clipboard sends show up here while Palwyn runs."
                                TextWrapping="Wrap" />
                            <ItemsControl x:Name="ActivityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ActivityItem">
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind Glyph}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                MaxLines="1"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind Text}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Time}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<Window
    x:Class="Palwyn.App.RescueWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rescue files">

    <Grid x:Name="Root" Padding="20,16,20,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Copies photos, videos, music, downloads, documents and app media (like WhatsApp's) from the phone to this PC over adb, without using the phone's screen. Run it again to copy only what's new. Other apps' private data can't be copied."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FolderText"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="ChangeButton"
                Grid.Column="1"
                Click="Change_Click"
                Content="Change…" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar x:Name="Progress" Maximum="1" Value="0" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="StartButton"
                Click="Start_Click"
                Content="Copy to this PC"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Click="Cancel_Click"
                Content="Cancel"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>

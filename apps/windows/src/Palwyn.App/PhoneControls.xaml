<UserControl
    x:Class="Palwyn.App.PhoneControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Quick actions and media controls; used by the tray flyout and Home.  -->
    <StackPanel Spacing="12">
        <Border
            x:Name="MediaCard"
            Padding="12,10,8,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Visibility="Collapsed">
            <StackPanel Spacing="6">
                <StackPanel Spacing="0">
                    <TextBlock
                        x:Name="MediaApp"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        x:Name="MediaTitle"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="MediaArtist"
                        MaxLines="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Margin="-6,0,0,0" Orientation="Horizontal" Spacing="2">
                    <Button
                        AutomationProperties.Name="Previous"
                        Click="Media_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="previous"
                        ToolTipService.ToolTip="Previous">
                        <FontIcon FontSize="16" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="PlayPause"
                        AutomationProperties.Name="Play or pause"
                        Click="PlayPause_Click"
                        Style="{StaticResource IconButtonStyle}">
                        <FontIcon
                            x:Name="PlayPauseGlyph"
                            FontSize="16"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Next"
                        Click="Media_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="next"
                        ToolTipService.ToolTip="Next">
                        <FontIcon FontSize="16" Glyph="&#xE893;" />
                    </Button>
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        AutomationProperties.Name="Volume down"
                        Click="Media_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="volumeDown"
                        ToolTipService.ToolTip="Phone volume down">
                        <FontIcon FontSize="16" Glyph="&#xE993;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Volume up"
                        Click="Media_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="volumeUp"
                        ToolTipService.ToolTip="Phone volume up">
                        <FontIcon FontSize="16" Glyph="&#xE995;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="Actions" ColumnSpacing="8" RowSpacing="8" />

        <TextBlock
            x:Name="Result"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>

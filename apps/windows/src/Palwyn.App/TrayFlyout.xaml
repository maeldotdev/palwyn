<Window
    x:Class="Palwyn.App.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Palwyn.App"
    Title="Palwyn">

    <Grid
        x:Name="Root"
        Width="360"
        VerticalAlignment="Top"
        KeyDown="Root_KeyDown"
        Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootOffset" />
        </Grid.RenderTransform>
        <Grid.Resources>
            <Storyboard x:Name="Enter">
                <DoubleAnimation
                    Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.12" />
                <DoubleAnimation
                    x:Name="EnterSlide"
                    Storyboard.TargetName="RootOffset"
                    Storyboard.TargetProperty="Y"
                    From="12"
                    To="0"
                    Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:PhoneStatusHeader x:Name="Header" Margin="16,16,16,0" />

        <StackPanel
            Grid.Row="1"
            Margin="16,16,16,16"
            Spacing="12">
            <TextBlock
                x:Name="Message"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <Button
                x:Name="OpenButton"
                HorizontalAlignment="Stretch"
                Click="Open_Click"
                Content="Open Palwyn"
                Style="{StaticResource AccentButtonStyle}" />
            <local:PhoneControls />
            <!--  Quick pause for clipboard sync; the same setting as in Settings.  -->
            <ToggleSwitch
                x:Name="ClipboardSwitch"
                AutomationProperties.Name="Send what I copy to my phone"
                OffContent="Copies stay on this PC"
                OnContent="Copies go to your phone"
                Toggled="Clipboard_Toggled" />
            <!--  Opened by the footer's transparency button; the same setting as in Settings.  -->
            <Grid x:Name="TransparencyRow" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="Transparency" />
                <Slider
                    x:Name="TransparencySlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Transparency"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="5"
                    ValueChanged="Transparency_ValueChanged" />
                <TextBlock
                    x:Name="TransparencyValue"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Right" />
            </Grid>
        </StackPanel>

        <Grid
            Grid.Row="2"
            Padding="16,6,8,6"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <HyperlinkButton
                Margin="-8,0,0,0"
                Click="Open_Click"
                Content="Open Palwyn" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="ThemeButton"
                    Click="Theme_Click"
                    Style="{StaticResource IconButtonStyle}">
                    <FontIcon x:Name="ThemeGlyph" FontSize="16" />
                </Button>
                <Button
                    AutomationProperties.Name="Transparency"
                    Click="Transparency_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Transparency">
                    <FontIcon FontSize="16" Glyph="&#xE7F4;" />
                </Button>
                <Button
                    AutomationProperties.Name="Settings"
                    Click="Settings_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
                <Button
                    AutomationProperties.Name="Quit Palwyn"
                    Click="Quit_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Quit Palwyn">
                    <FontIcon FontSize="16" Glyph="&#xE7E8;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
